{
    "$schema": "./node_modules/nx/schemas/project-schema.json",
    "name": "aurelius-atlas",
    "targets": {
        "standalone-bundle": {
            "cache": true,
            "executor": "@nxlv/python:run-commands",
            "inputs": [
                "{workspaceRoot}/docker/**",
                "{workspaceRoot}/apps/*/docker/**",
                "{workspaceRoot}/infra/*/docker-compose.yaml",
                "{workspaceRoot}/infra/*/config/**",
                "{workspaceRoot}/infra/keycloak/import/**",
                "{workspaceRoot}/infra/keycloak/themes/**",
                "{workspaceRoot}/infra/observability/config/**",
                "{workspaceRoot}/tools/compose_cli.py",
                "{workspaceRoot}/tools/standalone_bundle.py",
                "{workspaceRoot}/tools/es-coredump-agent/**",
                "{workspaceRoot}/data/atlas-sample/**"
            ],
            "metadata": {
                "description": "Build the standalone bundle (17.3, DD-682): a mirror of the stack's compose pieces and the assets they mount, for the release artifact"
            },
            "options": {
                "command": "uv run python tools/standalone_bundle.py --version {args.version}",
                "cwd": "."
            },
            "outputs": ["{workspaceRoot}/dist/standalone-bundle.tar.gz"]
        },
        "test": {
            "cache": true,
            "configurations": {
                "ci": {
                    "junitxml": "junit.xml",
                    "trace-json": "trace.json"
                }
            },
            "executor": "@nxlv/python:run-commands",
            "inputs": [
                "pythonBase",
                "^default",
                "{projectRoot}/tests/**/*",
                "{workspaceRoot}/docker/**",
                "{workspaceRoot}/apps/*/docker/**",
                "{workspaceRoot}/helm/**",
                "{workspaceRoot}/infra/*/helm/**",
                "{workspaceRoot}/tools/es-coredump-agent/**"
            ],
            "metadata": {
                "description": "Run the chart-contract suite (DD-253): rendered-manifest invariants for every chart"
            },
            "options": {
                "command": "uv run pytest tests",
                "cwd": "."
            }
        }
    }
}

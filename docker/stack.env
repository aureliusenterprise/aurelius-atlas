# The repository's own answers for the folders the standalone stack's pieces
# require. This file is committed and holds NO secret: it names only certificate
# and sample folders, which are paths, not credentials. The umbrella names it in
# each app include (`env_file: stack.env`), so `docker compose -f docker/docker-compose.yaml
# --env-file <the three secret .env files> up -d` starts with no extra argument.
#
# Each value is relative to the compose piece that reads it (a relative path in a
# service rewrites from that piece's own folder), so `../certs` always means that
# project's `nx certgen` folder and `GATEWAY_CERTS_DIR` names the server's leaf.
#
# An install that ships the stack without this repository (the 17.3 bundle) sets
# the same keys in its own `.env`, which overrides this file; see docker/README.md
# and docker/.env.example. A piece names its folder through a variable precisely
# so a customer deployment cannot inherit a repository path by mistake (DD-687).

# The server piece (apps/aurelius-atlas-server/docker/compose.yaml).
SERVER_CERTS_DIR=../certs
SAMPLE_DIR=../../../data/atlas-sample

# The gateway piece (docker/gateway/compose.yaml): the edge leaf is the server's.
GATEWAY_CERTS_DIR=../../apps/aurelius-atlas-server/certs

# The webapp piece (apps/aurelius-atlas-webapp/docker/compose.yaml).
WEBAPP_CERTS_DIR=../certs

# The five aux pieces (apps/aurelius-atlas-*/docker/compose.yaml).
DATA2MODEL_CERTS_DIR=../certs
EMBEDDER_CERTS_DIR=../certs
LINEAGE_MODEL_CERTS_DIR=../certs
VALIDATE_ENTITY_CERTS_DIR=../certs
MCP_CERTS_DIR=../certs

# The standalone stack's settings, one file to copy to .env. Copy and fill it:
#
#   cp docker/.env.example docker/.env
#   docker compose -f docker/docker-compose.yaml --env-file docker/.env up -d
#
# In a checkout of this repository you do not need this file: the three .env files of the owning
# projects (apps/aurelius-atlas-server/.env, infra/keycloak/.env, infra/elasticsearch/.env) carry
# the same keys with working dev defaults, and the README names them at every command. This file
# is for an install that ships the stack without the repository's encrypted defaults.
#
# Compose reads a file named .env beside the compose file on its own, so --env-file is optional
# once the copy exists. The ${VAR:?} guards in the stack's compose files make a missing value
# fail the start with its name, rather than boot an open service.

# --- Elasticsearch (docker/elasticsearch/compose.yaml) -----------------------------------------
# The store's password, its JVM heap, and its published port. The standalone store publishes no
# port (docker/elasticsearch/compose.yaml resets the infra base's list), but compose still
# interpolates ELASTICSEARCH_PORT from the base before it applies that reset, so name it to keep a
# warning-free start.
ELASTICSEARCH_PASSWORD=
AURELIUS_ATLAS_SERVER_ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_HEAP=1g
ELASTICSEARCH_PORT=9200

# --- Keycloak (docker/keycloak/compose.yaml) ---------------------------------------------------
# The bootstrap administrator of the identity provider (realm master only — the realm
# aurelius-atlas holds no user, DD-673), and the database the provider runs on.
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=
KEYCLOAK_DATABASE_USERNAME=
KEYCLOAK_DATABASE_PASSWORD=

# --- The realm's client secrets (keycloak/aurelius-atlas.json) ---------------------------------
# The placeholders of the imported realm, one per service identity. The server signs its own
# browser leg with the first; the sample import and the tenant command sign through the next two;
# the validator signs its rules leg with the fourth; Grafana signs people in with the fifth (15.9).
ATLAS_SERVER_CLIENT_SECRET=
ATLAS_ADMIN_CLIENT_SECRET=
PROVISIONING_CLIENT_SECRET=
VALIDATE_ENTITY_CLIENT_SECRET=
GRAFANA_CLIENT_SECRET=

# --- The scanner service identities (infra/keycloak/docker-compose.yaml) -------------------------
# The Keycloak realm also holds the batch and streaming scanners, and the base identity-provider
# service requires their client secrets even when this stack runs none of them (DD-669). It also
# requires the two scanner database users. Name them so a stack that runs no scanner still starts;
# a scanner you do run reads the value it shares with the realm.
QUALITY_SCANNER_CLIENT_SECRET=
KAFKA_SCANNER_CLIENT_SECRET=
DB_SCANNER_CLIENT_SECRET=
DEV_USER_WRITER_PASSWORD=
DEV_USER_READER_PASSWORD=

# --- Telemetry (docker/observability/compose.yaml) ----------------------------------------------
# The shared ingest bearer of the collector's legacy leg (Keycloak and the webapp's edge carry it),
# and the one secret the realm's four otel-* ingest clients share (DD-675). Both join unguarded in
# the app pieces, so a stack without telemetry starts with them unset.
OTEL_COLLECTOR_INGEST_TOKEN=
OTEL_INGEST_CLIENT_SECRET=
# Grafana's local administrator: no one signs in as it, the tenant command keeps each tenant's Grafana
# organization through its API with it (15.9, TGF-12).
GRAFANA_ADMIN_PASSWORD=

# --- The tenant demo (docker compose --profile tenancy) ----------------------------------------
# The password of the operator the tenants one shot creates (README.md, Tenants).
DEMO_USER_OPERATOR_PASSWORD=

# --- TLS (infra/keycloak/certs/truststore.p12) ---------------------------------------------------
# The password of the PKCS12 truststore the stack's Keycloak JVM dials Postgres with. It must match
# the password docker/bin/make-certs.sh wrote the file with: that script reads the value from the
# shell environment first, then from infra/keycloak/.env, then from this file. Set it here, re-run
# the script, and the two agree. A checkout has the value in infra/keycloak/.env already.
TLS_TRUSTSTORE_PASSWORD=

# --- Folders the pieces mount (SBD-12, DD-687) --------------------------------------------------
# The nine names below are required, and every one names a folder the stack mounts read-only. Each
# value is relative to the compose piece that reads it, so `../certs` means that project's certificate
# folder. A piece fails the start with the name of the variable rather than mount a path it guessed.
#
# Leave these commented out when docker/stack.env travels with the stack: it answers all nine with the
# repository's paths. Uncomment and set them when you ship the pieces without that file. Do not name one
# with an empty value: compose takes an empty value from this file over stack.env, and the start fails.
#
# The server's own certificates, and the folder its import and tenancy one shots read (DD-684).
# SERVER_CERTS_DIR=../certs
# SAMPLE_DIR=/path/to/atlas-sample
# The edge leaf the proxy serves, which is the server's (DD-677).
# GATEWAY_CERTS_DIR=../../apps/aurelius-atlas-server/certs
# Each service's own leaf.
# WEBAPP_CERTS_DIR=../certs
# EMBEDDER_CERTS_DIR=../certs
# DATA2MODEL_CERTS_DIR=../certs
# LINEAGE_MODEL_CERTS_DIR=../certs
# VALIDATE_ENTITY_CERTS_DIR=../certs
# MCP_CERTS_DIR=../certs

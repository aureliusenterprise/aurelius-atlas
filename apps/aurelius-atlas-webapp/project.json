{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "i18n": {
        "locales": {
            "nl-NL": {
                "translation": "apps/aurelius-atlas-webapp/src/locale/messages.nl-NL.xlf"
            }
        },
        "sourceLocale": "en-US"
    },
    "implicitDependencies": ["aurelius-atlas-styles"],
    "name": "aurelius-atlas-webapp",
    "prefix": "aurelius-atlas-webapp",
    "projectType": "application",
    "sourceRoot": "apps/aurelius-atlas-webapp/src",
    "tags": [],
    "targets": {
        "build": {
            "configurations": {
                "development": {
                    "assets": [
                        {
                            "glob": "**/*",
                            "input": "apps/aurelius-atlas-webapp/dev"
                        },
                        {
                            "glob": "**/*",
                            "input": "apps/aurelius-atlas-webapp/public"
                        }
                    ],
                    "extractLicenses": false,
                    "localize": ["en-US"],
                    "optimization": false,
                    "sourceMap": true
                },
                "nl-NL": {
                    "localize": ["nl-NL"],
                    "sourceMap": true
                },
                "production": {
                    "assets": [
                        {
                            "glob": "**/*",
                            "input": "apps/aurelius-atlas-webapp/public"
                        }
                    ],
                    "budgets": [
                        {
                            "maximumError": "4mb",
                            "maximumWarning": "2mb",
                            "type": "initial"
                        },
                        {
                            "maximumError": "8kb",
                            "maximumWarning": "4kb",
                            "type": "anyComponentStyle"
                        }
                    ],
                    "optimization": {
                        "styles": {
                            "inlineCritical": false
                        }
                    },
                    "outputHashing": "all",
                    "statsJson": true
                }
            },
            "defaultConfiguration": "production",
            "executor": "@angular/build:application",
            "options": {
                "browser": "apps/aurelius-atlas-webapp/src/main.ts",
                "inlineStyleLanguage": "scss",
                "localize": ["en-US", "nl-NL"],
                "outputPath": "dist/apps/aurelius-atlas-webapp",
                "polyfills": ["@angular/localize/init"],
                "styles": ["apps/aurelius-atlas-webapp/src/styles.scss"],
                "tsConfig": "apps/aurelius-atlas-webapp/tsconfig.app.json"
            },
            "outputs": ["{options.outputPath}"]
        },
        "check-purity": {
            "command": "bash scripts/check-webapp-purity.sh",
            "options": {
                "cwd": "{projectRoot}"
            }
        },
        "e2e": {
            "cache": false,
            "configurations": {
                "ci": {
                    "junitxml": "junit-e2e.xml",
                    "trace-json": "trace-e2e.json"
                }
            },
            "dependsOn": [],
            "executor": "@nxlv/python:run-commands",
            "metadata": {
                "description": "Run this project's e2e suite against the Helm umbrella on minikube (k8s-only, DD-283/284). Precondition: tools/cluster/install.sh up (with the realm's edge browser origins, realm-origins) and the hosts block for the browser legs (install.sh hosts, sudo)."
            },
            "options": {
                "command": "uv run pytest e2e --browser chromium --browser firefox --browser webkit --tracing retain-on-failure",
                "cwd": "{projectRoot}"
            },
            "parallelism": false
        },
        "extract-i18n": {
            "executor": "@angular/build:extract-i18n",
            "options": {
                "buildTarget": "aurelius-atlas-webapp:build",
                "outputPath": "apps/aurelius-atlas-webapp/src/locale"
            }
        },
        "sbom": {
            "command": "cyclonedx-esbuild --gather-license-texts --output-reproducible -o {args.appSbomPath} dist/{projectRoot}/browser-stats.json",
            "dependsOn": ["build"],
            "options": {
                "appSbomPath": "{projectRoot}/app-sbom.json"
            }
        },
        "serve": {
            "configurations": {
                "development": {
                    "buildTarget": "aurelius-atlas-webapp:build:development"
                },
                "nl-NL": {
                    "buildTarget": "aurelius-atlas-webapp:build:development,nl-NL",
                    "port": 4301
                },
                "production": {
                    "buildTarget": "aurelius-atlas-webapp:build:production"
                }
            },
            "continuous": true,
            "defaultConfiguration": "development",
            "dependsOn": [
                {
                    "target": "decrypt"
                },
                {
                    "target": "certgen"
                },
                {
                    "projects": ["aurelius-atlas-server", "aurelius-atlas-dev-keycloak"],
                    "target": "serve"
                }
            ],
            "executor": "@angular/build:dev-server",
            "options": {
                "host": "127.0.0.1",
                "port": 4300,
                "proxyConfig": "apps/aurelius-atlas-webapp/proxy.conf.json"
            }
        },
        "test": {
            "configurations": {
                "ci": {
                    "coverage": true,
                    "coverageReporters": ["lcov"],
                    "watch": false
                }
            },
            "dependsOn": ["check-purity"],
            "executor": "@nx/angular:unit-test"
        }
    }
}

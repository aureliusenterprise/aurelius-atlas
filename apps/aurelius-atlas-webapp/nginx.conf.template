# Multi-locale serving for the Aurelius Atlas webapp (SHL-11).
# Each locale is built into its own subdirectory (browser/en-US, browser/nl-NL)
# with <base href="/<locale>/">. See https://angular.dev/guide/i18n/deploy
# Baked at image build to /etc/nginx/conf.d/default.conf. This file is a
# *template*: the ${AURELIUS_ATLAS_WEBAPP_*} placeholders (API/OTLP upstream
# origins + TLS names, trust anchor path, DNS resolver) are resolved by the
# deployment, which mounts its filled-in copy over that path — see
# e2e/config/nginx.conf for a static resolved variant. The hardened runtime
# image has no shell tooling to render at start, on purpose; an unresolved
# container fails at config parse instead of serving with template defaults.
# NOTE: the hardened image includes this file inside its *http* block (the
# last include in /etc/nginx/nginx.conf), so the file may open with http-level
# directives (the limit_req_zone below); the server block then follows. Keep
# everything else server-scoped.

# Browser rate limit on the API proxy (SRV-09, DD-238): a per-client-IP leaky
# bucket, 300 requests/minute sustained with a burst of 100 served immediately
# (nodelay — a browser issues a page's requests at once), refusals answered
# 429 (nginx's default 503 is a server-fault code and retries are pointless
# for a browser). The key is a map, not $binary_remote_addr: requests from
# private ranges — internal services calling the API directly, and dev/e2e
# traffic — get the empty key, which nginx does not account (the blog's
# allowlist pattern). The limit is the browser's: an internal caller bursting
# is working, an attacker bursting is browsing. Extend the geo block (a 0 entry
# per range) for deployment networks that are not RFC 1918.
geo $atlas_api_limit_key {
    default 1;
    127.0.0.0/8 0;
    ::1 0;
    10.0.0.0/8 0;
    172.16.0.0/12 0;
    192.168.0.0/16 0;
}

map $atlas_api_limit_key $atlas_api_limit_addr {
    0 "";
    1 $binary_remote_addr;
}

limit_req_zone $atlas_api_limit_addr zone=atlas_api:10m rate=300r/m;
limit_req_status 429;

server {
    listen 8080;

    # Version-disclosure hardening: keep the nginx version out of the
    # Server header and error pages.
    server_tokens off;

    root /usr/share/nginx/html;

    include /etc/nginx/app.d/*.conf;

    # Security headers (M2).
    #   - style-src 'unsafe-inline': @angular/build inlines critical CSS as a
    #     <style> tag in index.html (no hash available at config time).
    #   - script-src 'self' + the theme pre-render hash: the build ships one
    #     inline script — the data-theme bootstrap (DD-159) — whose sha256
    #     rides here (the silent-check-sso hash precedent). Recompute with
    #     the example app's recipe if the script's bytes change.
    #   - connect-src/frame-src add the Keycloak origins (7.3, APC-05):
    #     keycloak-js fetches the realm metadata cross-origin and the
    #     silent-SSO iframe embeds the Keycloak authorization endpoint.
    #     Deployments list them via ${AURELIUS_ATLAS_WEBAPP_KEYCLOAK_ORIGINS}
    #     (space-separated, e.g. "https://sso.example.com").
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-bLKOgCGxZwqOQyQKetdKOchl5wDQhHnVVp+X0UOvsBw='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ${AURELIUS_ATLAS_WEBAPP_KEYCLOAK_ORIGINS}; frame-src 'self' ${AURELIUS_ATLAS_WEBAPP_KEYCLOAK_ORIGINS}" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # keycloak-js silent SSO iframe: same-origin only, and its one inline
    # script is allowed via hash (sha256 of the script element's content —
    # recompute with:
    #   python -c "import re,base64,hashlib; h=re.search(r'<script>(.*?)</script>', open('public/silent-check-sso.html').read(), 16).group(1); print('sha256-'+base64.b64encode(hashlib.sha256(h.encode()).digest()).decode())"
    # ) instead of loosening CSP app-wide. add_header here replaces the
    # inherited server-level set, so repeat the non-CSP headers.
    location = /silent-check-sso.html {
        # The asset is built per locale (browser/<locale>/silent-check-sso.html);
        # keycloak-js requests it at the origin root, so resolve it explicitly.
        try_files /en-US/silent-check-sso.html /nl-NL/silent-check-sso.html =404;
        add_header Content-Security-Policy "default-src 'none'; script-src 'sha256-miQlUSMEyNrSzHUXigoiPbVCIcDQvHCRNPop+QMZUus='; frame-ancestors 'self'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "no-referrer" always;
    }

    # Browser preferred-language detection via the Accept-Language header.
    # (The http-level `map` directive from the Angular docs doesn't fit here:
    # the hardened image only includes conf.d inside the server scope.)
    set $accept_language en-US;

    # Same-origin reverse proxies for the backend API and the OTLP collector,
    # mirroring the dev-server proxy (proxy.conf.json). The /api prefix is
    # forwarded INTACT (DD-139): the Atlas server serves its routes under
    # /api/atlas/..., and the client composes `${apiBaseUrl}/atlas/...` from
    # config — a rewriting proxy would double-strip the prefix. The /otel
    # prefix is stripped, as the collector serves /v1/traces at its root.
    # The CSP above already promises connect-src 'self' for /api and /otel —
    # these locations make that real in production.
    #
    # The upstream names below are the service names of this repo's stacks
    # (compose project / k8s Service names); the whole block follows the same
    # "parameterize for your topology" rule as the Keycloak origins above
    # (${AURELIUS_ATLAS_WEBAPP_*} placeholders, resolved by the
    # deployment when it mounts its copy). The hostname goes through a
    # variable so nginx resolves it via `resolver`
    # *per request* — a missing backend then returns 502 instead of refusing
    # to boot the SPA. 127.0.0.11 is Docker's built-in DNS; change it for
    # other environments (e.g. kube-dns at 10.96.0.10).
    resolver ${AURELIUS_ATLAS_WEBAPP_DNS_RESOLVER} valid=10s ipv6=off;

    location /api/ {
        # The browser bucket (SRV-09): public addresses above, in a burst;
        # 429 on overflow. The server itself never rate limits — internal
        # callers arrive on private ranges, whose key is empty and unaccounted.
        limit_req zone=atlas_api burst=100 nodelay;
        set $api_upstream ${AURELIUS_ATLAS_WEBAPP_API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Upstream is TLS with the stack's own certificate. This upstream
        # carries user bearer tokens from 7.3 on, so its certificate MUST be
        # verified: unverified, a network-path attacker between nginx and the
        # API can impersonate the backend and harvest every token. The trust
        # anchor is deployment-specific: AURELIUS_ATLAS_WEBAPP_TLS_CA_FILE
        # (default /certs/ca.pem; dev/e2e stacks bind-mount the project CA
        # there, deployments mount their own). nginx refuses to start when the
        # file is missing — failing loudly beats silently unverified.
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate ${AURELIUS_ATLAS_WEBAPP_TLS_CA_FILE};
        proxy_ssl_name ${AURELIUS_ATLAS_WEBAPP_API_UPSTREAM_NAME};
        proxy_redirect off;
    }

    # OTLP push (traces and metrics) for the browser SDK; same-origin keeps
    # the CSP at 'self' (the wiring arrives with 7.3's observability slice).
    # The collector's browser leg (4318) authenticates the signed-in user:
    # the SPA attaches its Keycloak access token to every OTLP push, and the
    # proxy passes the Authorization header through untouched (nginx's
    # default — no proxy_set_header here) to the collector's OIDC receiver,
    # which validates issuer, signature and the otel-collector audience
    # (DD-193, CIA-01/02). A logged-out push has no token and is answered
    # 401 — accepted, the telemetry gate is the login (DD-193).
    location /otel/ {
        set $otel_upstream ${AURELIUS_ATLAS_WEBAPP_OTEL_UPSTREAM};
        rewrite ^/otel(/.*)$ $1 break;
        proxy_pass $otel_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate ${AURELIUS_ATLAS_WEBAPP_TLS_CA_FILE};
        proxy_ssl_name ${AURELIUS_ATLAS_WEBAPP_OTEL_UPSTREAM_NAME};
        proxy_redirect off;
    }

    # Redirect "/" to the preferred locale, defaulting to en-US.
    location = / {
        if ($http_accept_language ~* "^nl") {
            set $accept_language nl-NL;
        }
        return 302 /$accept_language/$is_args$args;
    }

    # Serve each locale's app; unknown paths under a locale prefix fall back
    # to that locale's index.html so client-side routing keeps working.
    location /en-US/ {
        try_files $uri $uri/ /en-US/index.html;
    }

    location /nl-NL/ {
        try_files $uri $uri/ /nl-NL/index.html;
    }

    # Unknown paths fall back to the default locale's app (SPA routing).
    location / {
        try_files $uri /en-US/index.html;
    }
}

{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "implicitDependencies": [
        "aurelius-atlas-core",
        "aurelius-atlas-dev-elasticsearch",
        "aurelius-atlas-dev-observability",
        "aurelius-atlas-model",
        "aurelius-atlas-store-es"
    ],
    "name": "aurelius-atlas-server",
    "projectType": "application",
    "sourceRoot": "{projectRoot}/aurelius_atlas_server",
    "tags": [],
    "targets": {
        "docker-build": {
            "dependsOn": [{ "target": "build" }, { "dependencies": true, "target": "docker-build" }]
        },
        "docker-publish": {
            "dependsOn": [
                { "target": "build" },
                { "dependencies": true, "params": "forward", "target": "docker-publish" }
            ]
        },
        "serve": {
            "continuous": true,
            "dependsOn": [
                { "target": "decrypt" },
                { "target": "certgen" },
                {
                    "projects": ["aurelius-atlas-dev-elasticsearch", "aurelius-atlas-dev-observability"],
                    "target": "serve"
                }
            ],
            "executor": "@nxlv/python:run-commands",
            "metadata": {
                "description": "Serve the Atlas API on https://localhost:21000 against the dev store; the dashboards come from the dashboard image (DD-034)"
            },
            "options": {
                "command": "uv run python -m aurelius_atlas_server"
            }
        }
    }
}

{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "implicitDependencies": [
        "aurelius-atlas-core",
        "aurelius-atlas-dashboard",
        "aurelius-atlas-dev-elasticsearch",
        "aurelius-atlas-dev-keycloak",
        "aurelius-atlas-dev-observability",
        "aurelius-atlas-model",
        "aurelius-atlas-otel",
        "aurelius-atlas-store-es"
    ],
    "name": "aurelius-atlas-server",
    "projectType": "application",
    "sourceRoot": "{projectRoot}/aurelius_atlas_server",
    "tags": [],
    "targets": {
        "docker-build": {
            "dependsOn": [
                { "target": "build" },
                { "dependencies": true, "target": "docker-build" },
                { "projects": ["aurelius-atlas-dashboard"], "target": "build" }
            ]
        },
        "docker-publish": {
            "dependsOn": [
                { "target": "build" },
                { "dependencies": true, "params": "forward", "target": "docker-publish" },
                { "projects": ["aurelius-atlas-dashboard"], "target": "build" }
            ]
        },
        "e2e": {
            "cache": false,
            "configurations": {
                "ci": {
                    "junitxml": "junit-e2e.xml",
                    "trace-json": "trace-e2e.json"
                }
            },
            "dependsOn": [],
            "executor": "@nxlv/python:run-commands",
            "metadata": {
                "description": "Run this project's e2e suite against the Helm umbrella on minikube (k8s-only, DD-283). Precondition: tools/cluster/install.sh up — the suite's gate fails fast without it."
            },
            "options": {
                "command": "uv run pytest e2e",
                "cwd": "{projectRoot}"
            }
        },
        "serve": {
            "continuous": true,
            "dependsOn": [
                { "target": "decrypt" },
                { "target": "certgen" },
                {
                    "projects": [
                        "aurelius-atlas-dev-elasticsearch",
                        "aurelius-atlas-dev-keycloak",
                        "aurelius-atlas-dev-observability"
                    ],
                    "target": "serve"
                },
                { "projects": ["aurelius-atlas-dashboard"], "target": "build" }
            ],
            "executor": "@nxlv/python:run-commands",
            "metadata": {
                "description": "Serve the Atlas API and the dashboards on https://localhost:21000 against the dev store"
            },
            "options": {
                "command": "uv run python -m aurelius_atlas_server"
            }
        }
    }
}

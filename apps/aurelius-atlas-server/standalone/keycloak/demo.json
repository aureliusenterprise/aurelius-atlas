{
    "clientScopeMappings": {
        "aurelius-atlas-server": [
            {
                "client": "aurelius",
                "roles": ["atlas-read", "atlas-write", "atlas-types", "atlas-admin"]
            }
        ]
    },
    "clients": [
        {
            "attributes": {
                "pkce.code.challenge.method": "S256",
                "post.logout.redirect.uris": "https://localhost:9000/atlas2/"
            },
            "clientAuthenticatorType": "client-secret",
            "clientId": "aurelius-atlas-server",
            "description": "The Atlas server's confidential client: the dashboards sign in through it (authorization code with PKCE), and its tokens are accepted by the server.",
            "directAccessGrantsEnabled": false,
            "enabled": true,
            "frontchannelLogout": true,
            "fullScopeAllowed": true,
            "name": "aurelius-atlas-server",
            "protocol": "openid-connect",
            "protocolMappers": [
                {
                    "config": {
                        "access.token.claim": "true",
                        "id.token.claim": "true",
                        "userinfo.token.claim": "true"
                    },
                    "consentRequired": false,
                    "name": "organization groups",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-organization-group-membership-mapper"
                }
            ],
            "publicClient": false,
            "redirectUris": ["https://localhost:9000/atlas2/login.jsp"],
            "secret": "${ATLAS_SERVER_CLIENT_SECRET}",
            "serviceAccountsEnabled": false,
            "standardFlowEnabled": true,
            "webOrigins": []
        },
        {
            "attributes": {
                "pkce.code.challenge.method": "S256",
                "post.logout.redirect.uris": "https://localhost:9000/*"
            },
            "clientId": "aurelius",
            "description": "The public client the webapp signs in through (authorization code with PKCE), and the sample import with a password; its tokens carry the server's roles.",
            "directAccessGrantsEnabled": true,
            "enabled": true,
            "fullScopeAllowed": false,
            "name": "aurelius",
            "protocol": "openid-connect",
            "protocolMappers": [
                {
                    "config": {
                        "access.token.claim": "true",
                        "id.token.claim": "true",
                        "userinfo.token.claim": "true"
                    },
                    "consentRequired": false,
                    "name": "organization groups",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-organization-group-membership-mapper"
                }
            ],
            "publicClient": true,
            "redirectUris": ["https://localhost:9000/*"],
            "serviceAccountsEnabled": false,
            "standardFlowEnabled": true,
            "webOrigins": ["https://localhost:9000"]
        }
    ],
    "displayName": "Aurelius Atlas demo",
    "enabled": true,
    "loginTheme": "aurelius",
    "loginWithEmailAllowed": false,
    "organizations": [
        {
            "alias": "operators",
            "description": "The operator organization: runs the platform, keeps the default indices (ADR 063)",
            "enabled": true,
            "groups": [
                {
                    "id": "de0e0000-0000-4000-8000-000000000001",
                    "name": "atlas-read"
                },
                {
                    "id": "de0e0000-0000-4000-8000-000000000002",
                    "name": "atlas-write"
                },
                {
                    "id": "de0e0000-0000-4000-8000-000000000003",
                    "name": "atlas-types"
                },
                {
                    "id": "de0e0000-0000-4000-8000-000000000004",
                    "name": "atlas-admin"
                }
            ],
            "members": [
                {
                    "groups": [
                        "de0e0000-0000-4000-8000-000000000001",
                        "de0e0000-0000-4000-8000-000000000002",
                        "de0e0000-0000-4000-8000-000000000003",
                        "de0e0000-0000-4000-8000-000000000004"
                    ],
                    "username": "atlas"
                }
            ],
            "name": "operators"
        },
        {
            "alias": "acme",
            "description": "The sample tenant (15.5a)",
            "enabled": true,
            "groups": [
                {
                    "id": "deac0000-0000-4000-8000-000000000001",
                    "name": "atlas-read"
                },
                {
                    "id": "deac0000-0000-4000-8000-000000000002",
                    "name": "atlas-write"
                },
                {
                    "id": "deac0000-0000-4000-8000-000000000003",
                    "name": "atlas-types"
                },
                {
                    "id": "deac0000-0000-4000-8000-000000000004",
                    "name": "atlas-admin"
                }
            ],
            "members": [
                {
                    "groups": ["deac0000-0000-4000-8000-000000000001", "deac0000-0000-4000-8000-000000000002"],
                    "username": "steward"
                },
                {
                    "groups": ["deac0000-0000-4000-8000-000000000001"],
                    "username": "scientist"
                },
                {
                    "groups": ["deac0000-0000-4000-8000-000000000001"],
                    "username": "atlas"
                }
            ],
            "name": "acme"
        }
    ],
    "organizationsEnabled": true,
    "realm": "demo",
    "registrationAllowed": false,
    "roles": {
        "client": {
            "aurelius-atlas-server": [
                {
                    "description": "Read the types, the entities and their classifications",
                    "name": "atlas-read"
                },
                {
                    "description": "Create, change and delete entities, relationships and their classifications",
                    "name": "atlas-write"
                },
                {
                    "description": "Create, change and delete types",
                    "name": "atlas-types"
                },
                {
                    "description": "Import, export, purge and the admin audits",
                    "name": "atlas-admin"
                }
            ]
        },
        "realm": [
            {
                "attributes": {},
                "clientRole": false,
                "composite": false,
                "description": "Runs the platform: holds at most atlas-read outside the operator organization (TEN-06, ADR 063)",
                "name": "atlas-operator"
            }
        ]
    },
    "sslRequired": "external",
    "users": [
        {
            "clientRoles": {
                "aurelius-atlas-server": ["atlas-read", "atlas-write", "atlas-types", "atlas-admin"]
            },
            "credentials": [
                {
                    "type": "password",
                    "value": "${DEMO_USER_ATLAS_PASSWORD}"
                }
            ],
            "email": "atlas@aureliusenterprise.com",
            "enabled": true,
            "firstName": "Atlas",
            "lastName": "Administrator",
            "realmRoles": ["atlas-operator"],
            "username": "atlas"
        },
        {
            "clientRoles": {
                "aurelius-atlas-server": ["atlas-read", "atlas-write"]
            },
            "credentials": [
                {
                    "type": "password",
                    "value": "${DEMO_USER_STEWARD_PASSWORD}"
                }
            ],
            "email": "steward@aureliusenterprise.com",
            "enabled": true,
            "firstName": "Data",
            "lastName": "Steward",
            "username": "steward"
        },
        {
            "clientRoles": {
                "aurelius-atlas-server": ["atlas-read"]
            },
            "credentials": [
                {
                    "type": "password",
                    "value": "${DEMO_USER_SCIENTIST_PASSWORD}"
                }
            ],
            "email": "scientist@aureliusenterprise.com",
            "enabled": true,
            "firstName": "Data",
            "lastName": "Scientist",
            "username": "scientist"
        }
    ]
}

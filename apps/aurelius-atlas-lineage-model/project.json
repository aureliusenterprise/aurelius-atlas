{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "implicitDependencies": [
        "aurelius-atlas-auth",
        "aurelius-atlas-data2model",
        "aurelius-atlas-data2model-client",
        "aurelius-atlas-infra-keycloak",
        "aurelius-atlas-infra-observability",
        "aurelius-atlas-lineage-model-client",
        "aurelius-atlas-otel",
        "aurelius-atlas-server-client"
    ],
    "name": "aurelius-atlas-lineage-model",
    "projectType": "application",
    "sourceRoot": "{projectRoot}/aurelius_atlas_lineage_model",
    "tags": [],
    "targets": {
        "e2e": {
            "cache": true,
            "dependsOn": [
                { "target": "decrypt" },
                { "dependencies": true, "target": "decrypt" },
                { "target": "certgen" },
                { "projects": ["aurelius-atlas-data2model"], "target": "certgen" },
                { "target": "docker-build" },
                { "dependencies": true, "target": "up" }
            ],
            "executor": "@nxlv/python:run-commands",
            "metadata": {
                "description": "E2E: the 8.2 chain with the real data2model (DD-200)"
            },
            "options": {
                "command": "uv run pytest e2e",
                "cwd": "{projectRoot}",
                "envFile": "apps/aurelius-atlas-lineage-model/.env"
            }
        },
        "serve": {
            "continuous": true,
            "dependsOn": [
                { "target": "decrypt" },
                { "target": "certgen" },
                {
                    "projects": ["aurelius-atlas-infra-keycloak", "aurelius-atlas-infra-observability"],
                    "target": "up"
                }
            ],
            "executor": "@nxlv/python:run-commands",
            "metadata": {
                "description": "Serve the lineage-model API on https://localhost:21002"
            },
            "options": {
                "command": "uv run python -m aurelius_atlas_lineage_model",
                "envFile": "apps/aurelius-atlas-lineage-model/.env"
            },
            "readyWhen": {
                "port": 21002
            }
        }
    }
}

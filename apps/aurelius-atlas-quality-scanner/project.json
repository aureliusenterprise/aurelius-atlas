{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "implicitDependencies": [
        "aurelius-atlas-model",
        "aurelius-atlas-otel",
        "aurelius-atlas-quality",
        "aurelius-atlas-server-client"
    ],
    "name": "aurelius-atlas-quality-scanner",
    "projectType": "application",
    "sourceRoot": "{projectRoot}/aurelius_atlas_quality_scanner",
    "tags": [],
    "targets": {
        "e2e": {
            "configurations": {
                "ci": {
                    "junitxml": "junit-e2e.xml",
                    "trace-json": "trace-e2e.json"
                }
            },
            "dependsOn": [
                { "target": "decrypt" },
                { "target": "certgen" },
                { "projects": ["aurelius-atlas-server"], "target": "docker-build" },
                {
                    "projects": [
                        "aurelius-atlas-dev-keycloak",
                        "aurelius-atlas-dev-observability",
                        "aurelius-atlas-dev-elasticsearch"
                    ],
                    "target": "up"
                }
            ],
            "executor": "@nxlv/python:run-commands",
            "metadata": {
                "description": "E2E: the scanner in-process against a real server (DD-223: shared dev stack, never restarted, so never parallel)"
            },
            "options": {
                "command": "uv run pytest e2e",
                "cwd": "{projectRoot}",
                "envFile": "apps/aurelius-atlas-quality-scanner/.env"
            },
            "parallelism": false
        },
        "scan": {
            "dependsOn": [{ "target": "decrypt" }],
            "executor": "@nxlv/python:run-commands",
            "metadata": {
                "description": "Run one quality scan: uv run python -m aurelius_atlas_quality_scanner [--dry-run] [--dataset <qualifiedName>]"
            },
            "options": {
                "command": "uv run python -m aurelius_atlas_quality_scanner",
                "envFile": "apps/aurelius-atlas-quality-scanner/.env"
            }
        }
    }
}

{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "implicitDependencies": ["aurelius-atlas-dev-elasticsearch", "aurelius-atlas-server"],
    "metadata": {
        "dockerCompose": { "serve": false }
    },
    "name": "aurelius-atlas-dashboard",
    "projectType": "application",
    "release": {
        "version": {
            "versionActions": "tools/plugins/noop-version-actions.ts"
        }
    },
    "sourceRoot": "{projectRoot}",
    "tags": [],
    "targets": {
        "build": {
            "cache": true,
            "executor": "nx:run-commands",
            "inputs": [
                "{projectRoot}/build.Dockerfile",
                "{projectRoot}/dashboardv2/package-lock.json",
                "{projectRoot}/dashboardv2/gruntfile.js",
                "{projectRoot}/dashboardv2/public/**/*",
                "{projectRoot}/dashboardv3/package-lock.json",
                "{projectRoot}/dashboardv3/gruntfile.js",
                "{projectRoot}/dashboardv3/public/**/*"
            ],
            "metadata": {
                "description": "Build dashboardv2 and dashboardv3 into dist/ (v2 at the root, v3 under n/)"
            },
            "options": {
                "command": "docker buildx build . -f {projectRoot}/build.Dockerfile --output type=local,dest={projectRoot}/dist"
            },
            "outputs": ["{projectRoot}/dist"]
        },
        "e2e": {
            "cache": true,
            "configurations": {
                "ci": {
                    "junitxml": "junit-e2e.xml",
                    "trace-json": "trace-e2e.json"
                }
            },
            "dependsOn": [
                { "target": "decrypt" },
                { "target": "certgen" },
                { "target": "up" },
                { "dependencies": true, "target": "up" }
            ],
            "executor": "@nxlv/python:run-commands",
            "metadata": {
                "description": "Run the dashboard tests against the nginx origin and the API-only server, on the dev store"
            },
            "options": {
                "command": "uv run pytest e2e",
                "cwd": "{projectRoot}"
            }
        },
        "up": {
            "dependsOn": [
                { "target": "decrypt" },
                { "target": "certgen" },
                { "projects": ["aurelius-atlas-server"], "target": "certgen" },
                { "target": "docker-build" },
                { "projects": ["aurelius-atlas-server"], "target": "docker-build" },
                { "dependencies": true, "target": "up" }
            ]
        }
    }
}

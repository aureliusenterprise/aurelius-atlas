{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "implicitDependencies": [
        "aurelius-atlas-auth",
        "aurelius-atlas-dev-keycloak",
        "aurelius-atlas-dev-observability",
        "aurelius-atlas-otel",
        "aurelius-atlas-validate-entity-client"
    ],
    "name": "aurelius-atlas-validate-entity",
    "projectType": "application",
    "sourceRoot": "{projectRoot}/aurelius_atlas_validate_entity",
    "tags": [],
    "targets": {
        "e2e-cluster": {
            "cache": false,
            "executor": "@nxlv/python:run-commands",
            "metadata": {
                "description": "(10.5b) Run this project's e2e suite against the Helm umbrella on minikube (ATLAS_E2E_TARGET=cluster) instead of the compose stack. Precondition: tools/cluster/install.sh up. Local-only lane: shared-cluster serialism — never run two e2e-cluster suites in parallel."
            },
            "options": {
                "command": "ATLAS_E2E_TARGET=cluster uv run pytest e2e",
                "cwd": "{projectRoot}"
            }
        },
        "serve": {
            "continuous": true,
            "dependsOn": [
                { "target": "decrypt" },
                { "target": "certgen" },
                {
                    "projects": ["aurelius-atlas-dev-keycloak", "aurelius-atlas-dev-observability"],
                    "target": "serve"
                }
            ],
            "executor": "@nxlv/python:run-commands",
            "metadata": {
                "description": "Serve the validate-entity API on https://localhost:21003"
            },
            "options": {
                "command": "uv run python -m aurelius_atlas_validate_entity"
            }
        }
    }
}

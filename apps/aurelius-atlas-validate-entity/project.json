{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "implicitDependencies": [
        "aurelius-atlas-auth",
        "aurelius-atlas-dev-keycloak",
        "aurelius-atlas-dev-observability",
        "aurelius-atlas-otel",
        "aurelius-atlas-validate-entity-client"
    ],
    "name": "aurelius-atlas-validate-entity",
    "projectType": "application",
    "sourceRoot": "{projectRoot}/aurelius_atlas_validate_entity",
    "tags": [],
    "targets": {
        "e2e": {
            "cache": false,
            "configurations": {
                "ci": {
                    "junitxml": "junit-e2e.xml",
                    "trace-json": "trace-e2e.json"
                }
            },
            "dependsOn": [],
            "executor": "@nxlv/python:run-commands",
            "metadata": {
                "description": "Run this project's e2e suite against the Helm umbrella on minikube (k8s-only, DD-283). Precondition: tools/cluster/install.sh up — the suite's gate fails fast without it."
            },
            "options": {
                "command": "uv run pytest e2e",
                "cwd": "{projectRoot}"
            }
        },
        "serve": {
            "continuous": true,
            "dependsOn": [
                { "target": "decrypt" },
                { "target": "certgen" },
                {
                    "projects": ["aurelius-atlas-dev-keycloak", "aurelius-atlas-dev-observability"],
                    "target": "serve"
                }
            ],
            "executor": "@nxlv/python:run-commands",
            "metadata": {
                "description": "Serve the validate-entity API on https://localhost:21003"
            },
            "options": {
                "command": "uv run python -m aurelius_atlas_validate_entity"
            }
        }
    }
}

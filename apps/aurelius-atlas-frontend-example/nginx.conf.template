# Multi-locale serving for the Aurelius frontend example.
# Each locale is built into its own subdirectory (browser/en-US, browser/nl-NL)
# with <base href="/<locale>/">. See https://angular.dev/guide/i18n/deploy
# Baked at image build to /etc/nginx/conf.d/default.conf. This file is a
# *template*: the ${AURELIUS_ATLAS_FRONTEND_*} placeholders (API/OTLP
# upstream origins + TLS names, trust anchor path, DNS resolver, Keycloak
# CSP origins) are resolved by the deployment, which mounts its filled-in
# copy over that path — see e2e/config/nginx.conf for a static resolved
# variant. The hardened runtime image has no shell tooling to render at
# start, on purpose; an unresolved container fails at config parse instead
# of serving with template defaults.
# NOTE: the hardened image includes this file at *server* level, so only
# server-scoped directives are allowed here (no http-level `map`).
server {
    listen 8080;

    # Version-disclosure hardening: keep the nginx version out of the
    # Server header and error pages.
    server_tokens off;

    root /usr/share/nginx/html;

    include /etc/nginx/app.d/*.conf;

    # Security headers (M2): the SPA carries Keycloak bearer tokens, so it
    # gets CSP, clickjacking and MIME-sniffing protections. Adjust
    # connect-src/frame origins for your IdP when deploying.
    #   - style-src 'unsafe-inline': @angular/build inlines critical CSS as a
    #     <style> tag in index.html (no hash available at config time).
    #   - connect-src: API and OTLP are same-origin (/api, /otel); the
    #     keycloak-js client fetches the realm metadata from Keycloak
    #     (origins parameterized via AURELIUS_ATLAS_FRONTEND_KEYCLOAK_ORIGINS).
    #   - frame-src: keycloak-js silent SSO embeds the Keycloak authorization
    #     page in a hidden iframe (cross-origin by default).
    #   - script-src hash: @angular/build's critical-CSS step (beasties)
    #     ships the full stylesheet deferred (<link media="print">) plus one
    #     fixed inline <script> that flips it to media="all" once loaded. The
    #     hash pins that exact script body, not arbitrary inline code. If it
    #     drifts (Angular/beasties upgrade), browsers block the script and the
    #     link stays media="print" — invisible to the eye (critical CSS is
    #     inlined) but caught by the frontend e2e media-flip test. Recompute
    #     from the built index.html with:
    #     python -c "import re,base64,hashlib; html=open('dist/apps/aurelius-atlas-frontend-example/browser/en-US/index.html').read(); m=[s for s in re.findall(r'<script>(.*?)</script>', html, 16) if 'data-beasties-media' in s][0]; print('sha256-'+base64.b64encode(hashlib.sha256(m.encode()).digest()).decode())"
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-LMY6wYoFV9I4wWzxaq1N/dTpl4iurQktw706UCHK3vM='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ${AURELIUS_ATLAS_FRONTEND_KEYCLOAK_ORIGINS}; frame-src 'self' ${AURELIUS_ATLAS_FRONTEND_KEYCLOAK_ORIGINS}" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # keycloak-js silent SSO iframe: same-origin only, and its one inline
    # script is allowed via hash (sha256 of the script element's content —
    # recompute with:
    #   python -c "import re,base64,hashlib; h=re.search(r'<script>(.*?)</script>', open('public/silent-check-sso.html').read(), 16).group(1); print('sha256-'+base64.b64encode(hashlib.sha256(h.encode()).digest()).decode())"
    # ) instead of loosening CSP app-wide. add_header here replaces the
    # inherited server-level set, so repeat the non-CSP headers.
    location = /silent-check-sso.html {
        # The asset is built per locale (browser/<locale>/silent-check-sso.html);
        # keycloak-js requests it at the origin root, so resolve it explicitly.
        try_files /en-US/silent-check-sso.html /nl-NL/silent-check-sso.html =404;
        add_header Content-Security-Policy "default-src 'none'; script-src 'sha256-miQlUSMEyNrSzHUXigoiPbVCIcDQvHCRNPop+QMZUus='; frame-ancestors 'self'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "no-referrer" always;
    }

    # Browser preferred-language detection via the Accept-Language header.
    # (The http-level `map` directive from the Angular docs doesn't fit here:
    # the hardened image only includes conf.d inside the server scope.)
    set $accept_language en-US;

    # Same-origin reverse proxies for the backend API and the OTLP collector,
    # mirroring the dev-server proxy (proxy.conf.json): the /api or /otel
    # prefix is stripped before forwarding, so the upstream serves its routes
    # at its own root. The CSP above already promises connect-src 'self' for
    # /api and /otel — these locations make that real in production.
    #
    # The upstream names below are the service names of this repo's stacks
    # (compose project / k8s Service names); the whole block follows the same
    # "parameterize for your topology" rule as the CSP Keycloak origins
    # above (${AURELIUS_ATLAS_FRONTEND_*} placeholders, resolved by the
    # deployment when it mounts its copy). The hostname goes through a
    # variable so nginx resolves it via `resolver`
    # *per request* — a missing backend then returns 502 instead of refusing
    # to boot the SPA. 127.0.0.11 is Docker's built-in DNS; change it for
    # other environments (e.g. kube-dns at 10.96.0.10).
    resolver ${AURELIUS_ATLAS_FRONTEND_DNS_RESOLVER} valid=10s ipv6=off;

    location /api/ {
        set $api_upstream ${AURELIUS_ATLAS_FRONTEND_API_UPSTREAM};
        rewrite ^/api(/.*)$ $1 break;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Upstream is TLS with the stack's own certificate. This upstream
        # carries user bearer tokens, so its certificate MUST be verified:
        # unverified, a network-path attacker between nginx and the API can
        # impersonate the backend and harvest every token. The trust anchor is
        # deployment-specific: AURELIUS_ATLAS_FRONTEND_TLS_CA_FILE (default
        # /certs/ca.pem; dev/e2e stacks bind-mount the project CA there,
        # deployments mount their own). nginx refuses to start when the file
        # is missing — failing loudly beats silently unverified.
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate ${AURELIUS_ATLAS_FRONTEND_TLS_CA_FILE};
        proxy_ssl_name ${AURELIUS_ATLAS_FRONTEND_API_UPSTREAM_NAME};
        proxy_redirect off;
    }

    # OTLP push (traces and metrics) for the browser SDK; same-origin keeps
    # the CSP at 'self' (see the provideAureliusOpenTelemetry* wiring).
    # The collector's browser leg (4318) authenticates the signed-in user:
    # the SPA attaches its Keycloak access token to every OTLP push, and the
    # proxy passes the Authorization header through untouched (nginx's
    # default — no proxy_set_header here) to the collector's OIDC receiver,
    # which validates issuer, signature and the otel-collector audience
    # (DD-193, CIA-01/02). A logged-out push has no token and is answered
    # 401 — accepted, the telemetry gate is the login (DD-193).
    location /otel/ {
        set $otel_upstream ${AURELIUS_ATLAS_FRONTEND_OTEL_UPSTREAM};
        rewrite ^/otel(/.*)$ $1 break;
        proxy_pass $otel_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate ${AURELIUS_ATLAS_FRONTEND_TLS_CA_FILE};
        proxy_ssl_name ${AURELIUS_ATLAS_FRONTEND_OTEL_UPSTREAM_NAME};
        proxy_redirect off;
    }

    # Redirect "/" to the preferred locale, defaulting to en-US.
    location = / {
        if ($http_accept_language ~* "^nl") {
            set $accept_language nl-NL;
        }
        return 302 /$accept_language/$is_args$args;
    }

    # Serve each locale's app; unknown paths under a locale prefix fall back
    # to that locale's index.html so client-side routing keeps working.
    location /en-US/ {
        try_files $uri $uri/ /en-US/index.html;
    }

    location /nl-NL/ {
        try_files $uri $uri/ /nl-NL/index.html;
    }

    # Unknown paths fall back to the default locale's app (SPA routing).
    location / {
        try_files $uri /en-US/index.html;
    }
}

{
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "name": "aurelius-atlas-ui",
    "prefix": "aurelius-atlas-ui",
    "projectType": "library",
    "sourceRoot": "libs/angular/aurelius-atlas-ui/src",
    "tags": [],
    "targets": {
        "build": {
            "configurations": {
                "development": {},
                "production": {
                    "tsConfig": "libs/angular/aurelius-atlas-ui/tsconfig.lib.prod.json"
                }
            },
            "defaultConfiguration": "production",
            "executor": "@nx/angular:ng-packagr-lite",
            "options": {
                "project": "libs/angular/aurelius-atlas-ui/ng-package.json",
                "tsConfig": "libs/angular/aurelius-atlas-ui/tsconfig.lib.json"
            },
            "outputs": ["{workspaceRoot}/dist/{projectRoot}"]
        },
        "build-storybook": {
            "configurations": {
                "ci": {
                    "quiet": true
                }
            },
            "executor": "@storybook/angular:build-storybook",
            "options": {
                "assets": [
                    {
                        "glob": "**/*",
                        "input": "libs/angular/aurelius-atlas-ui/.storybook/assets",
                        "output": "/assets/"
                    }
                ],
                "browserTarget": "aurelius-atlas-ui:build-storybook",
                "compodoc": false,
                "configDir": "libs/angular/aurelius-atlas-ui/.storybook",
                "experimentalZoneless": true,
                "outputDir": "dist/storybook/aurelius-atlas-ui",
                "styles": ["libs/angular/aurelius-atlas-ui/.storybook/styles.scss"]
            },
            "outputs": ["{options.outputDir}"]
        },
        "chromatic": {
            "dependsOn": ["build-storybook", "decrypt"],
            "executor": "nx:run-commands",
            "options": {
                "command": "chromatic --storybook-build-dir=dist/storybook/aurelius-atlas-ui --no-interactive --exit-once-uploaded"
            }
        },
        "static-storybook": {
            "configurations": {
                "ci": {
                    "buildTarget": "aurelius-atlas-ui:build-storybook:ci"
                }
            },
            "dependsOn": ["build-storybook"],
            "executor": "@nx/web:file-server",
            "options": {
                "buildTarget": "aurelius-atlas-ui:build-storybook",
                "host": "127.0.0.1",
                "port": 4500,
                "spa": true,
                "staticFilePath": "dist/storybook/aurelius-atlas-ui"
            }
        },
        "storybook": {
            "configurations": {
                "ci": {
                    "quiet": true
                }
            },
            "executor": "@storybook/angular:start-storybook",
            "options": {
                "assets": [
                    {
                        "glob": "**/*",
                        "input": "libs/angular/aurelius-atlas-ui/.storybook/assets",
                        "output": "/assets/"
                    }
                ],
                "browserTarget": "aurelius-atlas-ui:build-storybook",
                "compodoc": false,
                "configDir": "libs/angular/aurelius-atlas-ui/.storybook",
                "experimentalZoneless": true,
                "host": "127.0.0.1",
                "port": 4400,
                "styles": ["libs/angular/aurelius-atlas-ui/.storybook/styles.scss"]
            }
        },
        "test": {
            "configurations": {
                "ci": {
                    "coverage": true,
                    "coverageReporters": ["lcov"],
                    "watch": false
                }
            },
            "executor": "@nx/angular:unit-test"
        },
        "test-storybook": {
            "executor": "nx:run-commands",
            "options": {
                "command": "test-storybook -c libs/angular/aurelius-atlas-ui/.storybook --url=http://127.0.0.1:4400"
            }
        }
    }
}

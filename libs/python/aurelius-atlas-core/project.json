{
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "implicitDependencies": [
        "aurelius-atlas-dev-elasticsearch",
        "aurelius-atlas-store-es",
        "aurelius-atlas-typesystem"
    ],
    "name": "aurelius-atlas-core",
    "projectType": "library",
    "sourceRoot": "{projectRoot}/aurelius_atlas_core",
    "tags": [],
    "targets": {
        "e2e-cluster": {
            "cache": false,
            "executor": "@nxlv/python:run-commands",
            "metadata": {
                "description": "(10.5b) Run this library's e2e suite against the Helm umbrella on minikube (ATLAS_E2E_TARGET=cluster) instead of the dev store. Precondition: tools/cluster/install.sh up. Local-only lane: shared-cluster serialism — never run two e2e-cluster suites in parallel."
            },
            "options": {
                "command": "ATLAS_E2E_TARGET=cluster uv run pytest e2e",
                "cwd": "{projectRoot}"
            }
        }
    }
}

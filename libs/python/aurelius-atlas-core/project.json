{
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "implicitDependencies": [
        "aurelius-atlas-dev-elasticsearch",
        "aurelius-atlas-store-es",
        "aurelius-atlas-typesystem"
    ],
    "name": "aurelius-atlas-core",
    "projectType": "library",
    "sourceRoot": "{projectRoot}/aurelius_atlas_core",
    "tags": [],
    "targets": {
        "e2e": {
            "cache": false,
            "configurations": {
                "ci": {
                    "junitxml": "junit-e2e.xml",
                    "trace-json": "trace-e2e.json"
                }
            },
            "dependsOn": [],
            "executor": "@nxlv/python:run-commands",
            "metadata": {
                "description": "Run this library's e2e suite against the Helm umbrella on minikube (k8s-only, DD-283). Precondition: tools/cluster/install.sh up — the suite's gate fails fast without it."
            },
            "options": {
                "command": "uv run pytest e2e",
                "cwd": "{projectRoot}"
            }
        }
    }
}

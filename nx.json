{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "analytics": false,
    "defaultBase": "main",
    "generators": {
        "@nx/angular:application": {
            "linter": "eslint",
            "style": "scss",
            "unitTestRunner": "vitest-analog"
        },
        "@nx/angular:component": {
            "style": "scss"
        },
        "@nx/angular:library": {
            "linter": "eslint",
            "unitTestRunner": "vitest-analog"
        }
    },
    "namedInputs": {
        "default": ["{projectRoot}/**/*"],
        "production": [
            "default",
            "!{workspaceRoot}/docs/**/*",
            "!{projectRoot}/**/AGENTS.md",
            "!{projectRoot}/sonar-project.properties",
            "!{projectRoot}/e2e/**/*",
            "!{projectRoot}/src/test/**/*",
            "!{projectRoot}/src/**/*.spec.ts",
            "!{projectRoot}/src/**/*.stories.ts",
            "!{projectRoot}/tests/**/*"
        ],
        "pythonBase": ["default", "{workspaceRoot}/pyproject.toml", "{workspaceRoot}/uv.lock"],
        "secrets": ["{projectRoot}/.env.enc", "{workspaceRoot}/.sops.yaml"]
    },
    "neverConnectToCloud": true,
    "plugins": [
        "./tools/plugins/alembic.ts",
        "./tools/plugins/docker.ts",
        "./tools/plugins/docker-compose.ts",
        "./tools/plugins/mkdocs.ts",
        "./tools/plugins/openlineage.ts",
        "./tools/plugins/openmetadata.ts",
        "./tools/plugins/python.ts",
        "./tools/plugins/sonarqube.ts",
        "./tools/plugins/sops.ts",
        "./tools/plugins/sops-decrypt.ts",
        "./tools/plugins/sops-encrypt.ts",
        "./tools/plugins/tls.ts",
        {
            "options": {
                "buildTargetName": "build",
                "classesTargetName": "classes",
                "testTargetName": "test"
            },
            "plugin": "@nx/gradle"
        },
        {
            "options": {
                "targetName": "lint"
            },
            "plugin": "@nx/eslint/plugin"
        }
    ],
    "release": {
        "changelog": {
            "workspaceChangelog": {
                "file": "docs/CHANGELOG.md",
                "renderOptions": {
                    "authors": false,
                    "commitReferences": true,
                    "versionTitleDate": true
                }
            }
        },
        "projects": ["*"],
        "version": {
            "conventionalCommits": true
        }
    },
    "targetDefaults": {
        "@angular/build:application": {
            "cache": true,
            "dependsOn": ["^build"],
            "inputs": ["production", "^production"]
        },
        "@nx/angular:ng-packagr-lite": {
            "cache": true,
            "dependsOn": ["^build"],
            "inputs": ["production", "^production"]
        },
        "@nx/angular:unit-test": {
            "cache": true,
            "inputs": ["default", "^default"]
        },
        "@nx/eslint/plugin": {
            "cache": true,
            "inputs": ["default", "{workspaceRoot}/eslint.config.mjs"]
        },
        "@storybook/angular:build-storybook": {
            "cache": true,
            "inputs": ["default", "^default", "{projectRoot}/.storybook/**/*", "{projectRoot}/tsconfig.storybook.json"]
        },
        "decrypt": {
            "inputs": ["secrets"]
        },
        "docker-build": {
            "inputs": [
                "production",
                "^production",
                "{projectRoot}/Dockerfile",
                {
                    "dependentTasksOutputFiles": "**/*",
                    "transitive": true
                }
            ]
        },
        "docker-publish": {
            "inputs": [
                "production",
                "^production",
                "{projectRoot}/Dockerfile",
                {
                    "dependentTasksOutputFiles": "**/*",
                    "transitive": true
                }
            ]
        },
        "sonar": {
            "inputs": ["default", "^default"]
        }
    }
}

        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "Seconds since the collector process started (monotonic counter). A drop back to ~0 means it restarted - check for config reloads or crashes.",
            "fieldConfig": {
                "defaults": {
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            }
                        ]
                    },
                    "unit": "s"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 5,
                "w": 4,
                "x": 20,
                "y": 0
            },
            "id": 6,
            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "reduceOptions": {
                    "calcs": ["lastNotNull"]
                }
            },
            "targets": [
                {
                    "expr": "otelcol_process_uptime",
                    "refId": "A"
                }
            ],
            "title": "Collector Uptime",
            "type": "stat"
        },
        {
            "collapsed": false,
            "description": "Collector self-observability: ingest, export queues, resources.",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 5
            },
            "id": 100,
            "panels": [],
            "title": "OpenTelemetry Collector",
            "type": "row"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "Metric points received per second (rate over the current window), by receiver and transport. Hundreds/s is expected: every app plus every infra puller streams through here. A transport dropping to 0 means that producer stopped pushing.",
            "fieldConfig": {
                "defaults": {
                    "unit": "short"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 6
            },
            "id": 7,
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "targets": [
                {
                    "expr": "sum by (receiver, transport) (rate(otelcol_receiver_accepted_metric_points[5m]))",
                    "legendFormat": "{{receiver}}/{{transport}}",
                    "refId": "A"
                }
            ],
            "title": "Accepted Metric Points/s (receiver)",
            "type": "timeseries"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "Points and spans pushed out per second (rate over the current window), by exporter (prometheus/tempo/loki). Should track the receiver panel closely; sent below accepted for a while means export is falling behind - check the queue-size panel.",
            "fieldConfig": {
                "defaults": {
                    "unit": "short"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 6
            },
            "id": 8,
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "targets": [
                {
                    "expr": "sum by (exporter) (rate(otelcol_exporter_sent_metric_points[5m]))",
                    "legendFormat": "metrics/{{exporter}}",
                    "refId": "A"
                },
                {
                    "expr": "sum by (exporter) (rate(otelcol_exporter_sent_spans[5m]))",
                    "legendFormat": "spans/{{exporter}}",
                    "refId": "B"
                }
            ],
            "title": "Sent Points/Spans/s (exporter)",
            "type": "timeseries"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "Batches waiting in each exporter's send queue (live gauge). Near 0 is healthy; a growing queue means the backend is slow or unreachable and data may be dropped.",
            "fieldConfig": {
                "defaults": {
                    "unit": "short"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 14
            },
            "id": 9,
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "targets": [
                {
                    "expr": "sum by (exporter) (otelcol_exporter_queue_size)",
                    "legendFormat": "{{exporter}}",
                    "refId": "A"
                }
            ],
            "title": "Exporter Queue Size",
            "type": "timeseries"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "CPU cores in use (rate of process CPU seconds: 1.0 = one core fully busy) and resident memory in bytes - two different units on one chart, so read each series against its own scale. Scales with the throughput panels.",
            "fieldConfig": {
                "defaults": {
                    "unit": "short"
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byFrameRefID",
                            "options": "B"
                        },
                        "properties": [
                            {
                                "id": "unit",
                                "value": "bytes"
                            },
                            {
                                "id": "custom.axisPlacement",
                                "value": "right"
                            }
                        ]
                    }
                ]
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 14
            },
            "id": 10,
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "targets": [
                {
                    "expr": "rate(otelcol_process_cpu_seconds[5m])",
                    "legendFormat": "cpu",
                    "refId": "A"
                },
                {
                    "expr": "otelcol_process_memory_rss",
                    "legendFormat": "rss",
                    "refId": "B"
                }
            ],
            "title": "Collector CPU / RSS",
            "type": "timeseries"
        },
        {
            "collapsed": false,
            "description": "Loki ingestion and API health.",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 22
            },
            "id": 101,
            "panels": [],
            "title": "Loki",
            "type": "row"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "Log lines Loki ingested per time bucket (Prometheus increase()). Dev traffic is tens of lines rather than thousands, so whole counts read more honestly than a fractional per-second rate.",
            "fieldConfig": {
                "defaults": {
                    "unit": "short"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 23
            },
            "id": 11,
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "targets": [
                {
                    "expr": "sum(increase(loki_distributor_lines_received_total[$__interval]))",
                    "interval": "1m",
                    "legendFormat": "lines/s",
                    "refId": "A"
                }
            ],
            "title": "Log Lines Received (per bucket)",
            "type": "timeseries"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "Requests to Loki's HTTP API per second (rate over the current window), by status code. Mostly Prometheus scrapes and Grafana queries (2xx); rising 4xx/5xx usually means a bad LogQL query or a rejected write.",
            "fieldConfig": {
                "defaults": {
                    "unit": "short"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 23
            },
            "id": 12,
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "targets": [
                {
                    "expr": "sum by (status_code) (rate(loki_request_duration_seconds_count[5m]))",
                    "legendFormat": "{{status_code}}",
                    "refId": "A"
                }
            ],
            "title": "HTTP Requests/s by Status",
            "type": "timeseries"
        },
        {
            "collapsed": false,
            "description": "Tempo ingest health.",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 31
            },
            "id": 102,
            "panels": [],
            "title": "Tempo",
            "type": "row"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "Trace spans Tempo receives per second (rate over the current window). Small and bursty: one SPA page load produces a handful of spans, then quiet.",
            "fieldConfig": {
                "defaults": {
                    "unit": "short"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 32
            },
            "id": 13,
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "targets": [
                {
                    "expr": "sum(rate(tempo_distributor_spans_received_total[5m]))",
                    "legendFormat": "spans/s",
                    "refId": "A"
                }
            ],
            "title": "Spans Received/s",
            "type": "timeseries"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "95th percentile duration of span push requests into the distributor (rate over the current window). Sub-second is healthy; seconds-long pushes mean the ingester is struggling and producers may time out.",
            "fieldConfig": {
                "defaults": {
                    "unit": "s"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 32
            },
            "id": 14,
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, sum by (le) (rate(tempo_distributor_push_duration_seconds_bucket[5m])))",
                    "legendFormat": "p95",
                    "refId": "A"
                }
            ],
            "title": "Push Duration p95 (s)",
            "type": "timeseries"
        }
    ],
    "refresh": "10s",
    "schemaVersion": 40,
    "tags": ["aurelius", "observability", "self-monitoring"],
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "timezone": "browser",
    "title": "Observability Stack",
    "uid": "aurelius-atlas-observability-obsv",
    "version": 1
}

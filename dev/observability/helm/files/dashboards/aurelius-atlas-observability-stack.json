{
    "annotations": {
        "list": []
    },
    "description": "Health of the dev observability pipeline itself: OTel Collector, Loki (logs), Tempo (traces), Prometheus (metrics). Up cards read 1 when the last Prometheus scrape succeeded. Throughput here is what the other Aurelius dashboards feed through the stack.",
    "id": null,
    "panels": [
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "Prometheus scrape-target health (1 = last scrape succeeded, 0 = failed) - it says the endpoint answered, not that the component works. Main OTLP receiver endpoint.",
            "fieldConfig": {
                "defaults": {
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "red",
                                "value": null
                            },
                            {
                                "color": "green",
                                "value": 1
                            }
                        ]
                    },
                    "unit": "short"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 5,
                "w": 4,
                "x": 0,
                "y": 0
            },
            "id": 1,
            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "reduceOptions": {
                    "calcs": ["lastNotNull"]
                }
            },
            "targets": [
                {
                    "expr": "up{job=\"otel-collector\"}",
                    "refId": "A"
                }
            ],
            "title": "Collector Up",
            "type": "stat"
        },
        {
            "datasource": {

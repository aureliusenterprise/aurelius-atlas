{
    "annotations": {
        "list": []
    },
    "description": "OpenMetadata governance hub: its own server metrics/logs/traces (OTel Java agent), the Elasticsearch index it searches and the metadata Postgres it stores in - both scraped by metrics-puller sidecars. Request and operation panels count per time bucket.",
    "id": null,
    "panels": [
        {
            "collapsed": false,
            "description": "OpenMetadata's own server RED + JVM metrics via the OTel Java agent.",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 0
            },
            "id": 100,
            "panels": [],
            "title": "Server (OTel Java agent)",
            "type": "row"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "HTTP requests the OpenMetadata server served per time bucket (Prometheus increase()), grouped by status code. Whole counts; 2xx dominates during catalog syncs, 4xx appears for bad API calls.",
            "fieldConfig": {
                "defaults": {
                    "unit": "short"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 0,
                "y": 1
            },
            "id": 1,
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "targets": [
                {
                    "expr": "sum by (http_response_status_code) (increase(http_server_request_duration_seconds_count{exported_job=\"openmetadata\"}[$__interval]))",
                    "interval": "1m",
                    "legendFormat": "{{http_response_status_code}}",
                    "refId": "A"
                }
            ],
            "title": "Requests by Status (per bucket)",
            "type": "timeseries"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "95th percentile request duration over the current window (rate over histogram buckets, in seconds). OpenMetadata endpoints are heavy (catalog queries): seconds are normal here, unlike the FastAPI app.",
            "fieldConfig": {
                "defaults": {
                    "unit": "s"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 8,
                "y": 1
            },
            "id": 2,
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{exported_job=\"openmetadata\"}[5m])))",
                    "legendFormat": "p95",
                    "refId": "A"
                }
            ],
            "title": "Duration p95 (s)",
            "type": "timeseries"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "Connections in the server's database pool by state (live gauge). Pool exhaustion shows up as API requests queueing for a connection.",
            "fieldConfig": {
                "defaults": {
                    "unit": "short"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 16,
                "y": 1
            },
            "id": 3,
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "targets": [
                {
                    "expr": "sum by (state) (db_client_connections_usage{exported_job=\"openmetadata\"})",
                    "legendFormat": "{{state}}",
                    "refId": "A"
                }
            ],
            "title": "DB Pool Connections",
            "type": "timeseries"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "Memory in use by the JVM, heap vs non-heap (live gauge, bytes). Heap grows until a GC cycle frees it; a rising floor between collections hints at a leak.",
            "fieldConfig": {
                "defaults": {
                    "unit": "bytes"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 0,
                "y": 9
            },
            "id": 4,
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "targets": [
                {
                    "expr": "sum by (jvm_memory_type) (jvm_memory_used_bytes{exported_job=\"openmetadata\"})",
                    "legendFormat": "{{jvm_memory_type}}",
                    "refId": "A"
                }
            ],
            "title": "JVM Memory",
            "type": "timeseries"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "Total time spent paused for garbage collection per time bucket (Prometheus increase() of the pause-time sum). Seconds accumulated in each auto-sized bucket (1-minute floor): a handful of seconds per bucket is healthy; minutes of pause time means the heap is too small.",
            "fieldConfig": {
                "defaults": {
                    "unit": "s"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 8,
                "y": 9
            },
            "id": 5,
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "targets": [
                {
                    "expr": "sum by (jvm_gc_action) (increase(jvm_gc_duration_seconds_sum{exported_job=\"openmetadata\"}[$__interval]))",
                    "interval": "1m",
                    "legendFormat": "{{jvm_gc_action}}",
                    "refId": "A"
                }
            ],
            "title": "GC Pause Time (s per bucket)",
            "type": "timeseries"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "Recent JVM-wide CPU utilization as a fraction of available processors (instantaneous gauge, not averaged). Bursts during metadata ingest jobs are expected.",
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 16,
                "y": 9
            },
            "id": 6,
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "targets": [
                {
                    "expr": "jvm_cpu_recent_utilization_ratio{exported_job=\"openmetadata\"}",
                    "legendFormat": "cpu {{exported_instance}}",
                    "refId": "A"
                }
            ],
            "title": "JVM CPU",
            "type": "timeseries"
        },
        {
            "datasource": {
                "type": "loki",
                "uid": "loki"
            },
            "description": "OpenMetadata server logs (Loki, service_name=openmetadata): startup, ingest jobs, and API errors. Click a line to expand the full entry.",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 17
            },
            "id": 7,
            "options": {
                "dedupStrategy": "none",
                "enableLogDetails": true,
                "prettifyLogMessage": false,
                "showCommonLabels": false,
                "showLabels": true,
                "showTime": true,
                "wrapLogMessage": true
            },
            "targets": [
                {
                    "direction": "backward",
                    "expr": "{service_name=\"openmetadata\"}",
                    "queryType": "range",
                    "refId": "A"
                }
            ],
            "title": "Logs",
            "type": "logs"
        },
        {
            "datasource": {
                "type": "tempo",
                "uid": "tempo"
            },
            "description": "Recent traces of the OpenMetadata server (javaagent): API handlers and their SQL. Open a row for the span waterfall. Search covers the recent ingest window.",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 17
            },
            "id": 8,
            "options": {
                "showHeader": true
            },
            "targets": [
                {
                    "datasource": {
                        "type": "tempo",
                        "uid": "tempo"
                    },
                    "limit": 20,
                    "query": "{resource.service.name = \"openmetadata\"}",
                    "queryType": "traceql",
                    "refId": "A"
                }
            ],
            "title": "Traces (Tempo)",
            "type": "table"
        },
        {
            "collapsed": false,
            "description": "The search index OpenMetadata reads and writes (elasticsearch service, scraped by the openmetadata-infra metrics-puller).",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 25
            },
            "id": 101,
            "panels": [],
            "title": "Elasticsearch (metrics-puller)",
            "type": "row"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "Cluster status as a number: 1 = green, 2 = yellow (under-replicated shards), 0 = red (unassigned shards). Derived from the cluster-health gauge's status labels.",
            "fieldConfig": {
                "defaults": {
                    "mappings": [
                        {
                            "options": {
                                "0": {
                                    "color": "red",
                                    "index": 0,
                                    "text": "red"
                                },
                                "1": {
                                    "color": "green",
                                    "index": 1,
                                    "text": "green"
                                },
                                "2": {
                                    "color": "yellow",
                                    "index": 2,
                                    "text": "yellow"
                                }
                            },
                            "type": "value"
                        }
                    ],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "red",
                                "value": null
                            },
                            {
                                "color": "green",
                                "value": 1
                            },
                            {
                                "color": "yellow",
                                "value": 2
                            }
                        ]
                    },
                    "unit": "short"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 5,
                "w": 4,
                "x": 0,
                "y": 26
            },
            "id": 9,
            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "reduceOptions": {
                    "calcs": ["lastNotNull"]
                }
            },
            "targets": [
                {
                    "expr": "(sum(elasticsearch_cluster_health{exported_job=\"openmetadata-infra\", status=\"green\"}) or vector(0)) + 2 * (sum(elasticsearch_cluster_health{exported_job=\"openmetadata-infra\", status=\"yellow\"}) or vector(0))",
                    "refId": "A"
                }
            ],
            "title": "Cluster Health",
            "type": "stat"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "Shards in state active on the cluster right now (live gauge). Drops mean shards went unassigned.",
            "fieldConfig": {
                "defaults": {
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            }
                        ]
                    },
                    "unit": "short"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 5,
                "w": 4,
                "x": 4,
                "y": 26
            },
            "id": 10,
            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "reduceOptions": {
                    "calcs": ["lastNotNull"]
                }
            },
            "targets": [
                {
                    "expr": "elasticsearch_cluster_shards{exported_job=\"openmetadata-infra\", state=\"active\"}",
                    "refId": "A"
                }
            ],
            "title": "Active Shards",
            "type": "stat"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "Free disk on the Elasticsearch node (live gauge, bytes). Below the low-watermark Elasticsearch starts making indices read-only - watch this during big ingest runs.",
            "fieldConfig": {
                "defaults": {
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "red",
                                "value": null
                            },
                            {
                                "color": "green",
                                "value": 5368709120
                            }
                        ]
                    },
                    "unit": "bytes"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 5,
                "w": 4,
                "x": 8,
                "y": 26
            },
            "id": 11,
            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "reduceOptions": {
                    "calcs": ["lastNotNull"]
                }
            },
            "targets": [
                {
                    "expr": "elasticsearch_node_fs_disk_available_bytes{exported_job=\"openmetadata-infra\"}",
                    "refId": "A"
                }
            ],
            "title": "Disk Available",
            "type": "stat"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "Cluster tasks queued but not yet run (live gauge): shard allocation, mapping updates. 0 is healthy; a backlog means the master can't keep up.",
            "fieldConfig": {
                "defaults": {
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "orange",
                                "value": 1
                            }
                        ]
                    },
                    "unit": "short"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 5,
                "w": 4,
                "x": 12,
                "y": 26
            },
            "id": 12,
            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "reduceOptions": {
                    "calcs": ["lastNotNull"]
                }
            },
            "targets": [
                {
                    "expr": "sum(elasticsearch_cluster_pending_tasks{exported_job=\"openmetadata-infra\"}) or vector(0)",
                    "refId": "A"
                }
            ],
            "title": "Pending Tasks",
            "type": "stat"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "JVM heap in use by the Elasticsearch node (live gauge, bytes). Near the max triggers merges/evictions and search latency.",
            "fieldConfig": {
                "defaults": {
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            }
                        ]
                    },
                    "unit": "bytes"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 5,
                "w": 4,
                "x": 16,
                "y": 26
            },
            "id": 13,
            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "reduceOptions": {
                    "calcs": ["lastNotNull"]
                }
            },
            "targets": [
                {
                    "expr": "jvm_memory_heap_used_bytes{exported_job=\"openmetadata-infra\"}",
                    "refId": "A"
                }
            ],
            "title": "Heap Used",
            "type": "stat"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "Operating-system CPU used by the Elasticsearch node, percent (instantaneous gauge).",
            "fieldConfig": {
                "defaults": {
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "red",
                                "value": 90
                            }
                        ]
                    },
                    "unit": "percent"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 5,
                "w": 4,
                "x": 20,
                "y": 26
            },
            "id": 14,
            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "reduceOptions": {
                    "calcs": ["lastNotNull"]
                }
            },
            "targets": [
                {
                    "expr": "elasticsearch_os_cpu_usage_percent{exported_job=\"openmetadata-infra\"}",
                    "refId": "A"
                }
            ],
            "title": "OS CPU",
            "type": "stat"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "Completed search and index operations per time bucket (Prometheus increase()). Indexing bursts happen when OpenMetadata re-indexes the catalog; quiet otherwise.",
            "fieldConfig": {
                "defaults": {
                    "unit": "short"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 31
            },
            "id": 15,
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "targets": [
                {
                    "expr": "sum by (operation) (increase(elasticsearch_node_operations_completed_total{exported_job=\"openmetadata-infra\"}[$__interval]))",
                    "interval": "1m",
                    "legendFormat": "{{operation}}",
                    "refId": "A"
                }
            ],
            "title": "Search / Index Ops (per bucket)",
            "type": "timeseries"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "Tasks waiting in each Elasticsearch thread pool (live gauge), e.g. search and write. Sustained non-zero means the node is saturated for that operation type.",
            "fieldConfig": {
                "defaults": {
                    "unit": "short"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 31
            },
            "id": 16,
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "targets": [
                {
                    "expr": "sum by (thread_pool_name) (elasticsearch_node_thread_pool_tasks_queued{exported_job=\"openmetadata-infra\"})",
                    "legendFormat": "{{thread_pool_name}}",
                    "refId": "A"
                }
            ],
            "title": "Thread Pool Queued",
            "type": "timeseries"
        },
        {
            "collapsed": false,
            "description": "The Postgres instance storing OpenMetadata's metadata (service 'postgresql', scraped by the openmetadata-infra metrics-puller).",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 39
            },
            "id": 102,
            "panels": [],
            "title": "Metadata Postgres (metrics-puller)",
            "type": "row"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "Client connections to the metadata Postgres (live gauge), by state. The OpenMetadata server plus the puller hold most of them.",
            "fieldConfig": {
                "defaults": {
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            }
                        ]
                    },
                    "unit": "short"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 5,
                "w": 6,
                "x": 0,
                "y": 40
            },
            "id": 17,
            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "reduceOptions": {
                    "calcs": ["lastNotNull"]
                }
            },
            "targets": [
                {
                    "expr": "postgresql_backends{exported_job=\"openmetadata-infra\", exported_instance=\"postgresql:5432\"}",
                    "refId": "A"
                }
            ],
            "title": "Backends",
            "type": "stat"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "On-disk size of the OpenMetadata metadata database (live gauge) - catalog entities, lineage, tests. Accurate here: this row is OpenMetadata's own database.",
            "fieldConfig": {
                "defaults": {
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            }
                        ]
                    },
                    "unit": "bytes"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 5,
                "w": 6,
                "x": 6,
                "y": 40
            },
            "id": 18,
            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "reduceOptions": {
                    "calcs": ["lastNotNull"]
                }
            },
            "targets": [
                {
                    "expr": "postgresql_db_size_bytes{exported_job=\"openmetadata-infra\", exported_instance=\"postgresql:5432\"}",
                    "refId": "A"
                }
            ],
            "title": "DB Size",
            "type": "stat"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "Rows inserted / updated / deleted / fetched per time bucket (increase()) by OpenMetadata's queries. Bursts during ingest, quiet otherwise.",
            "fieldConfig": {
                "defaults": {
                    "unit": "short"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 40
            },
            "id": 19,
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "targets": [
                {
                    "expr": "sum by (operation) (increase(postgresql_operations_total{exported_job=\"openmetadata-infra\", exported_instance=\"postgresql:5432\"}[$__interval]))",
                    "interval": "1m",
                    "legendFormat": "{{operation}}",
                    "refId": "A"
                }
            ],
            "title": "Row Operations (per bucket)",
            "type": "timeseries"
        }
    ],
    "refresh": "10s",
    "schemaVersion": 40,
    "tags": ["aurelius", "governance", "observability"],
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "timezone": "browser",
    "title": "OpenMetadata (governance)",
    "uid": "aurelius-openmetadata-obsv",
    "version": 1
}

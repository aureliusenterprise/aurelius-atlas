{
    "containerEnv": {
        "NX_DAEMON": "true",
        "PLAYWRIGHT_BROWSERS_PATH": "/opt/playwright-browsers",
        "SOPS_AGE_KEY_FILE": "${containerWorkspaceFolder}/secrets/keys.txt"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "Angular.ng-template",
                "bierner.markdown-mermaid",
                "charliermarsh.ruff",
                "DavidAnson.vscode-markdownlint",
                "esbenp.prettier-vscode",
                "KnisterPeter.vscode-commitizen",
                "mtxr.sqltools",
                "mtxr.sqltools-driver-pg",
                "nrwl.angular-console",
                "PKief.material-icon-theme",
                "SonarSource.sonarlint-vscode",
                "tamasfe.even-better-toml",
                "vitest.explorer",
                "-ms-python.autopep8"
            ],
            "settings": {
                "[json]": {
                    "editor.defaultFormatter": "esbenp.prettier-vscode"
                },
                "[markdown]": {
                    "editor.defaultFormatter": "esbenp.prettier-vscode"
                },
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff"
                },
                "[toml]": {
                    "editor.defaultFormatter": "esbenp.prettier-vscode"
                },
                "[yaml]": {
                    "editor.defaultFormatter": "esbenp.prettier-vscode"
                },
                "dev.containers.mountWaylandSocket": false,
                "editor.formatOnSave": true,
                "editor.formatOnSaveMode": "file",
                "eslint.validate": ["json"],
                "files.exclude": {
                    "**/.angular": true,
                    "**/.git/objects/**": true,
                    "**/.gradle": true,
                    "**/.hypothesis": true,
                    "**/.mypy_cache": true,
                    "**/.nx": true,
                    "**/.pnpm-store": true,
                    "**/.pytest_cache": true,
                    "**/.ruff_cache": true,
                    "**/.scannerwork": true,
                    "**/.tmp": true,
                    "**/.tox": true,
                    "**/.trivy-cache": true,
                    "**/.venv": true,
                    "**/__pycache__": true,
                    "**/build": true,
                    "**/coverage": true,
                    "**/coverage.xml": true,
                    "**/dist": true,
                    "**/htmlcov": true,
                    "**/junit*.xml": true,
                    "**/node_modules": true,
                    "**/target": true,
                    "**/tmp": true,
                    "**/trace*.json": true,
                    "/site/**": true
                },
                "files.insertFinalNewline": true,
                "files.watcherExclude": {
                    "**/.angular": true,
                    "**/.git/objects/**": true,
                    "**/.gradle": true,
                    "**/.hypothesis": true,
                    "**/.mypy_cache": true,
                    "**/.nx": true,
                    "**/.pnpm-store": true,
                    "**/.pytest_cache": true,
                    "**/.ruff_cache": true,
                    "**/.scannerwork": true,
                    "**/.tmp": true,
                    "**/.tox": true,
                    "**/.trivy-cache": true,
                    "**/.venv": true,
                    "**/__pycache__": true,
                    "**/build": true,
                    "**/coverage": true,
                    "**/coverage.xml": true,
                    "**/dist": true,
                    "**/htmlcov": true,
                    "**/junit*.xml": true,
                    "**/node_modules": true,
                    "**/target": true,
                    "**/tmp": true,
                    "**/trace*.json": true,
                    "/site/**": true
                },
                "material-icon-theme.files.associations": {
                    "*.enc": "key",
                    "keys.txt": "key",
                    "project.json": "nx"
                },
                "python.analysis.exclude": {
                    "**/.venv": true,
                    "**/coverage": true,
                    "**/dist": true,
                    "**/target": true,
                    "**/tmp": true,
                    "site": true
                },
                "python.analysis.typeCheckingMode": "standard",
                "python.testing.pytestEnabled": true,
                "python.testing.unittestEnabled": false,
                "search.exclude": {
                    "**/coverage.xml": true,
                    "**/dist": true,
                    "**/junit*.xml": true,
                    "**/licenses.json": true,
                    "**/sbom.json": true,
                    "**/target": true,
                    "**/trace*.json": true,
                    "**/vulnerabilities.html": true,
                    "**/vulnerabilities.json": true,
                    "**/vulnerabilities.sarif": true,
                    "build/": true,
                    "coverage/": true,
                    "node_modules/": true,
                    "site/": true,
                    "tmp/": true
                },
                "terminal.integrated.gpuAcceleration": "on",
                "terminal.integrated.shellIntegration.enabled": true,
                "terminal.integrated.suggest.enabled": false,
                "vscode.env.isTelemetryEnabled": false
            }
        }
    },
    "features": {
        "./features/ci-runner": {},
        "./features/google-cloud-cli": {
            "installGkeGcloudAuthPlugin": true,
            "version": "latest"
        },
        "./features/playwright-browsers": {
            "version": "1.64.0"
        },
        "ghcr.io/devcontainers-extra/features/apt-packages:1": {
            "packages": ["age", "gnupg2", "libpq-dev", "libnss3-tools", "mkcert"]
        },
        "ghcr.io/devcontainers-extra/features/cosign:1.0.10": {},
        "ghcr.io/devcontainers-extra/features/cyclonedx-cli:1.0.10": {},
        "ghcr.io/devcontainers-extra/features/nx-npm:1": {
            "version": "23.3.0"
        },
        "ghcr.io/devcontainers-extra/features/sops:1": {
            "version": "latest"
        },
        "ghcr.io/devcontainers/features/docker-in-docker:4": {},
        "ghcr.io/devcontainers/features/github-cli:1": {
            "version": "latest"
        },
        "ghcr.io/devcontainers/features/java:1": {
            "installGradle": true,
            "version": "21.0.9-tem"
        },
        "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
            "helm": "4.3.1",
            "minikube": "none",
            "version": "1.37.1"
        },
        "ghcr.io/devcontainers/features/node:2": {
            "version": "24"
        },
        "ghcr.io/devcontainers/features/python:1": {
            "toolsToInstall": ["uv"],
            "version": "3.14"
        },
        "ghcr.io/dhoeric/features/trivy:1": {
            "version": "0.71.0"
        },
        "ghcr.io/postfinance/devcontainer-features/playwright-deps:2": {
            "installChromiumDeps": true,
            "installFirefoxDeps": true,
            "installWebkitDeps": true
        },
        "ghcr.io/postfinance/devcontainer-features/sonar-scanner-cli:1": {
            "includeJre": false,
            "version": "8.0.1.6346"
        }
    },
    "forwardPorts": [4200, 4400, 8000, 8080],
    "image": "mcr.microsoft.com/devcontainers/base:resolute",
    "name": "Aurelius Atlas",
    "onCreateCommand": {
        "npm": "bash .devcontainer/npm.sh",
        "uv": "bash .devcontainer/uv.sh"
    },
    "portsAttributes": {
        "4200": {
            "label": "Angular",
            "onAutoForward": "openBrowserOnce"
        },
        "4400": {
            "label": "Storybook",
            "onAutoForward": "openBrowser"
        },
        "8000": {
            "label": "FastAPI"
        },
        "8080": {
            "label": "Keycloak"
        }
    },
    "postCreateCommand": {
        "pre-commit": "bash .devcontainer/pre-commit.sh",
        "sops": "bash .devcontainer/sops.sh"
    },
    "runArgs": ["--add-host=keycloak.localhost:127.0.0.1"]
}
